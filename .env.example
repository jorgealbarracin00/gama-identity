PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1
SESSION_DURATION_SECONDS=86400
SESSION_RENEWAL_DURATION_SECONDS=2592000
REPOSITORY_MODE=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gama_identity
DATABASE_SSL=disable
# Native Apple App IDs and web Services IDs whose signed identity tokens GAMA accepts.
# APPLE_CLIENT_IDS=com.gamadynamics.CocoCompanion,com.gamadynamics.cocothellama.web
# Apple web authorization-code exchange. Configure all five values together.
# APPLE_WEB_CLIENT_ID=com.gamadynamics.cocothellama.web
# APPLE_WEB_REDIRECT_URI=https://cocothellama.com/api/auth/apple/callback
# APPLE_TEAM_ID=33VYKC5J83
# APPLE_KEY_ID=<10-character-key-id>
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Google OpenID client IDs whose signed identity tokens GAMA accepts.
# GOOGLE_CLIENT_IDS=<web-client-id>.apps.googleusercontent.com
# Google web authorization-code exchange. Configure all three values together.
# GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_SECRET=<server-only-secret>
# GOOGLE_WEB_REDIRECT_URI=https://cocothellama.com/api/auth/google/callback
# Email/password security. Links are built only from this trusted app allowlist.
IDENTITY_TRUSTED_APPS='[{"id":"coco-web","displayName":"Coco the Llama","baseUrl":"https://cocothellama.com"}]'
IDENTITY_DEFAULT_APP_ID=coco-web
IDENTITY_EMAIL_PROVIDER=disabled
# Required and server-only when IDENTITY_EMAIL_PROVIDER=resend.
# IDENTITY_EMAIL_FROM=Coco the Llama <hello@auth.cocothellama.com>
# RESEND_API_KEY=<server-only-secret>
IDENTITY_EMAIL_VERIFICATION_TTL_SECONDS=86400
IDENTITY_PASSWORD_RESET_TTL_SECONDS=3600
IDENTITY_RATE_LIMIT_WINDOW_SECONDS=900
IDENTITY_RATE_LIMIT_MAXIMUM_ATTEMPTS=5
# Use a unique random value of at least 32 characters in every deployed environment.
IDENTITY_RATE_LIMIT_SECRET=development-only-rate-limit-key-change-me
# Operator-only bootstrap inputs. Set only for `npm run bootstrap:coco`.
# COCO_OWNER_HUMAN_IDENTITY_ID=<existing-active-human-identity-id>
# COCO_WORKLOAD_SECRET=<at-least-24-character-secret>
# COCO_BOOTSTRAP_ACTOR_REFERENCE=<platform-operator-reference>
