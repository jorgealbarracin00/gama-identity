{
  "name": "gama-identity",
  "version": "1.1.0",
  "description": "Identity service foundation for the GAMA Platform.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:integration": "tsx --test \"test/integration/**/*.test.ts\"",
    "migrate": "tsx src/infrastructure/postgres/migrate-cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgealbarracin00/gama-identity.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/jorgealbarracin00/gama-identity/issues"
  },
  "homepage": "https://github.com/jorgealbarracin00/gama-identity#readme",
  "dependencies": {
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
